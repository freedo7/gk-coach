{
  "expo": {
    "name": "GK Coach",
    "slug": "gk-coach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/gk-coach-logo.jpeg",
    "scheme": "gkcoach",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/gk-coach-logo.jpeg"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/gk-coach-logo.jpeg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/gk-coach-logo.jpeg",
          "imageWidth": 220
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
