{
  "expo": {
    "name": "GK Coach",
    "slug": "gk-coach",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "gkcoach",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.freedo7.gkcoach",
      "buildNumber": "1",
      "supportsTablet": false
    },
    "android": {
      "package": "com.freedo7.gkcoach",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#f2f2f7"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/gk-coach-logo.jpeg",
          "imageWidth": 250,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#6FC22C"
        }
      ],
      "expo-screen-orientation",
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "06398aa4-c925-4ab6-8ade-1f41ce8bafcc"
      }
    },
    "owner": "freedo7"
  }
}
